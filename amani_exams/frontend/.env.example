# Normally you do NOT need this file.
#  - npm run dev   : the app forwards /api to Django at http://127.0.0.1:8000 by itself. If Django is elsewhere: BACKEND_URL=http://127.0.0.1:9000
#  - npm run build : set the API address, e.g.  NEXT_PUBLIC_API_URL=https://api.example.com   (no trailing slash)
# Setting NEXT_PUBLIC_API_URL in development makes the browser call that address directly (then Django must allow this origin with CORS).
#NEXT_PUBLIC_API_URL=https://api.example.com
#BACKEND_URL=http://127.0.0.1:8000
